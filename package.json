{
  "name": "nahrok-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Nahrok masaüstü uygulaması (Tauri). Plan ve sınırlar: PLAN.md",
  "scripts": {
    "tauri": "tauri",
    "build": "tauri build --no-bundle",
    "build:test": "tauri build --debug --no-bundle --config src-tauri/tauri.test.conf.json",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:smoke": "node tests/smoke.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "package:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
