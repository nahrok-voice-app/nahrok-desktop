{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nahrok",
  "mainBinaryName": "nahrok",
  "version": "1.1.0",
  "identifier": "com.nahrok.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["site", "settings"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Nahrok",
    "copyright": "Nahrok",
    "shortDescription": "Nahrok sesli sohbet"
  }
}
