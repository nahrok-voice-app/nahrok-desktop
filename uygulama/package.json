{
  "name": "nahrok-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Nahrok masaüstü (Tauri). Bkz. ../PLAN.md",
  "scripts": {
    "tauri": "tauri",
    "derle": "tauri build --no-bundle",
    "derle:sinama": "tauri build --debug --no-bundle --config src-tauri/tauri.sinama.conf.json",
