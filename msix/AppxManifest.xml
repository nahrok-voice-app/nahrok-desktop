<?xml version="1.0" encoding="utf-8"?>
<!-- scripts/package.ps1 doldurur: {IDENTITY} {PUBLISHER} {PUBLISHER_NAME} {VERSION}. Store değerleri msix/store.json'dan gelir. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="{IDENTITY}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Nahrok</DisplayName>
    <PublisherDisplayName>{PUBLISHER_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Nahrok sesli sohbet</Description>
  </Properties>
  <Dependencies>
    <!-- WebView2 Windows 11'de hazır gelir ve Windows günceller (PLAN.md çizgi 8) -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="tr-TR" />
  </Resources>
  <Applications>
    <Application Id="Nahrok" Executable="nahrok.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Nahrok" Description="Nahrok sesli sohbet" BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Bilgisayar açılınca başlatma. Çizgi 7: varsayılan kapalı; kullanıcı ayarlardan açar (src-tauri/src/startup.rs). -->
        <desktop:Extension Category="windows.startupTask" Executable="nahrok.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NahrokStartup" Enabled="false" DisplayName="Nahrok" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <!-- Çizgi 7: sürücü ve arka plan servisi yok. Tam güven masaüstü uygulaması + mikrofon. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
